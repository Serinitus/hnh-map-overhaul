<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<link rel="stylesheet" href="/js/dark.css">
		<style>
		</style>
        <title>{{.Page.Title}} - Admin</title>
	</head>
	<body>
		{{template "navbar.tmpl" .}}
		<div class="container">
            <form method="POST">
                <input type="hidden" name="map" value="{{.MapInfo.ID}}">
                <div class="row">
                    <div class="input-field col s12">
                        <input id="name" type="text" class="validate" name="name" value="{{.MapInfo.Name}}">
                        <label for="username">Name</label>
                    </div>
                </div>
                <div class="col s12">
                    <ul class="collection with-header">
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="hidden" value="true"{{if .MapInfo.Hidden}} checked="checked"{{end}}/>
                                <span>Hidden</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="priority" value="true"{{if .MapInfo.Priority}} checked="checked"{{end}}/>
                                <span>Priority</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="input-field col s12">
                    <select name="requiredAuth">
                        {{range .TierOptions}}
                        <option value="{{.Value}}"{{if eq .Value $.MapInfo.RequiredAuth}} selected="selected"{{end}}>{{.Label}}</option>
                        {{end}}
                    </select>
                    <label>Required Tier</label>
                </div>
                <button class="btn waves-effect waves-light" type="submit" name="action">Save</button>
            </form>
            {{if .ShowPreview}}
            <div class="card">
                <div class="card-content">
                    <h5>Preview</h5>
                    <p>Every grid tile on this map, stitched into one image
                        -- only available for maps at or under {{.MaxPreviewGrids}}
                        grids.</p>
                    <img src="/admin/mapPreview?map={{.MapInfo.ID}}" style="max-width:100%;image-rendering:pixelated;border:1px solid #444;">
                </div>
            </div>
            {{end}}
            <div class="card">
                <div class="card-content">
                    <h5>Delete map</h5>
                    <p>Permanently removes this map layer and everything on
                        it -- grids, tiles, markers, roads, and custom
                        markers.</p>
                    <a class="waves-effect waves-light red btn modal-trigger" href="#deleteMap">Delete!</a>
                    <div id="deleteMap" class="modal">
                        <div class="modal-content">
                        <h4>Delete "{{.MapInfo.Name}}"</h4>
                        <p>This will remove every grid, tile, marker, road, and custom marker on this map layer.</p>
                        <h5>THIS CANNOT BE UNDONE!</h5>
                        </div>
                        <div class="modal-footer">
                        <a href="#!" class="modal-close waves-effect waves-light green btn">Cancel</a>
                        <a href="/admin/deleteMap?map={{.MapInfo.ID}}" class="waves-effect waves-light red btn">DELETE</a>
                        </div>
                    </div>
                </div>
            </div>
		</div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
        <script>M.AutoInit();</script>
	</body>
</html>
