<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<link rel="stylesheet" href="/js/dark.css">
        <script src="/js/zepto.min.js"></script>
        <script src="/js/intercooler-1.2.1.min.js"></script>
		<style>
			.admin-section {
				margin-bottom: 24px;
				border: 1px solid #444;
				border-radius: 4px;
				padding: 8px 16px;
			}
			.admin-section summary {
				cursor: pointer;
				list-style-position: outside;
			}
			.admin-section summary h5 {
				display: inline-block;
				margin: 12px 0;
			}
			.icon-btn-group {
				display: flex;
				gap: 4px;
			}
			.icon-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 30px;
				height: 30px;
				border-radius: 50%;
				border: 1px solid #fff;
				color: #fff;
				text-decoration: none;
				cursor: pointer;
			}
			.icon-btn .material-icons {
				font-size: 18px;
			}
			.icon-btn.icon-btn-delete {
				background: #d32f2f;
				border-color: #d32f2f;
				color: #000;
			}
		</style>
        <title>{{.Page.Title}} - Admin</title>
	</head>
	<body>
		{{template "navbar.tmpl" .}}
		<div class="container">

            <!-- Public is a site-wide setting, not a user account, so it
                 sits above the Users section rather than inside it. -->
            <a href="/admin/public" class="waves-effect waves-light btn{{if .PublicEnabled}} green{{end}}">Public{{if .PublicEnabled}} (Enabled){{end}}</a>
            <br><br>
            <details class="admin-section">
                <summary><h5>Users</h5></summary>
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .Users}}
                        <tr>
                            <td>{{.}}</td>
                            <td><a href="/admin/user?user={{.}}" class="waves-effect waves-light btn">Edit</a></td>
                        </tr>
                        {{end}}
                    </tbody>
                </table>
                <a href="/admin/user" class="waves-effect waves-light btn">Add user</a>
            </details>
            <details class="admin-section">
                <summary><h5>Maps</h5></summary>
                <a href="/admin/duplicateMaps" class="waves-effect waves-light btn">Find duplicate small maps</a>
                <br><br>
                <table>
                    <thead>
                        <tr>
                            <th>Map</th>
                            <th>Order</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .Maps}}
                        <tr>
                            <td>{{.Name}}</td>
                            <td>
                                <form method="POST" action="/admin/setMapOrder" style="display:flex;gap:4px;align-items:center;">
                                    <input type="hidden" name="map" value="{{.ID}}">
                                    <input type="number" name="sortOrder" value="{{.SortOrder}}" title="Position in the map-switcher dropdown -- lower first, ties broken by name" style="width:70px;">
                                    <button type="submit" class="icon-btn" title="Save order" style="background:transparent;padding:0;">
                                        <i class="material-icons">save</i>
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="icon-btn-group">
                                    <a href="/admin/map?map={{.ID}}" class="icon-btn" title="Edit"><i class="material-icons">edit</i></a>
                                    <a ic-post-to="/admin/mapic?map={{.ID}}&action=toggle-hidden" class="icon-btn" title="Show/hide">{{block "admin/index.tmpl:toggle-hidden" .}}<i class="material-icons">{{if .Hidden}}visibility_off{{else}}visibility{{end}}</i>{{end}}</a>
                                    <a href="#deleteMap-{{.ID}}" class="icon-btn icon-btn-delete modal-trigger" title="Delete"><i class="material-icons">close</i></a>
                                </div>
                                <div id="deleteMap-{{.ID}}" class="modal">
                                    <div class="modal-content">
                                        <h4>Delete "{{.Name}}"</h4>
                                        <p>This will remove every grid, tile, marker, road, and custom marker on this map layer.</p>
                                        <h5>THIS CANNOT BE UNDONE!</h5>
                                    </div>
                                    <div class="modal-footer">
                                        <a href="#!" class="modal-close waves-effect waves-light green btn">Cancel</a>
                                        <a href="/admin/deleteMap?map={{.ID}}" class="waves-effect waves-light red btn">DELETE</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {{end}}
                    </tbody>
                </table>
            </details>
            <div class="card">
                <div class="card-content">
                    <h5>Default maps to hidden</h5>
                    <p>This makes new map layers hidden by default</p>
                    <form action="/admin/setDefaultHide" method="POST">
                    <div class="row">
                        <label>
                            <input type="checkbox" name="defaultHide" value="true"{{if .DefaultHide}} checked="checked"{{end}}/>
                            <span>Default Hidden</span>
                        </label>
                        <div class="input-field col s6">
                            <button class="btn waves-effect waves-light" type="submit" name="action">Save</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Set prefix for tokens</h5>
                    <p>Copy/paste-ready client tokens are normally built automatically from
                        whatever address you're using to reach this site right now -- leave
                        this blank unless that's wrong for your setup (e.g. an internal
                        hostname that doesn't match what clients need to use).</p>
                    <form action="/admin/setPrefix" method="POST">
                    <div class="row">
                        <div class="input-field col s6">
                            <input id="prefix" type="text" class="validate" name="prefix" value="{{.Prefix}}" placeholder="auto-detected -- leave blank">
                            <label for="prefix" class="active">Prefix override</label>
                        </div>
                        <div class="input-field col s6">
                            <button class="btn waves-effect waves-light" type="submit" name="action">Save</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Set title for pages</h5>
                    <form action="/admin/setTitle" method="POST">
                    <div class="row">
                        <div class="input-field col s6">
                            <input id="title" type="text" class="validate" name="title" value="{{.Page.Title}}">
                            <label for="title">Title</label>
                        </div>
                        <div class="input-field col s6">
                            <button class="btn waves-effect waves-light" type="submit" name="action">Save</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Ping sound</h5>
                    <p>Sound played for everyone when the map is pinged.</p>
                    <form action="/admin/setPingSound" method="POST">
                        {{range .PingSounds}}
                        <p>
                            <label>
                                <input name="sound" type="radio" value="{{.}}"{{if eq . $.PingSound}} checked="checked"{{end}} />
                                <span>{{.}}</span>
                            </label>
                        </p>
                        {{end}}
                        {{if not .PingSounds}}
                        <p>No sounds uploaded yet.</p>
                        {{end}}
                        <button class="btn waves-effect waves-light" type="submit" name="action">Use selected sound</button>
                    </form>
                    <br>
                    <form action="/admin/uploadPingSound" method="post" enctype="multipart/form-data">
                        <div class="file-field input-field">
                        <div class="btn">
                            <span>File</span>
                            <input type="file" name="sound" accept="audio/*">
                        </div>
                        <div class="file-path-wrapper">
                            <input class="file-path validate" type="text">
                        </div>
                        </div>
                        <button class="btn waves-effect waves-light" type="submit" name="action">Upload</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Wipe all data</h5>
                    <a class="waves-effect waves-light red btn modal-trigger" href="#wipe">Wipe!</a>
                    <div id="wipe" class="modal">
                        <div class="modal-content">
                        <h4>Wipe</h4>
                        <p>This will remove all grids and markers, and reset the 0,0 grid</p>
                        <h5>THIS CANNOT BE UNDONE!</h5>
                        </div>
                        <div class="modal-footer">
                        <a href="#!" class="modal-close waves-effect waves-light green btn">Cancel</a>
                        <a href="/admin/wipe" class="waves-effect waves-light red btn">WIPE</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Rebuild zooms</h5>
                    <a href="/admin/rebuildZooms" class="waves-effect waves-light red btn">Rebuild Zooms</a>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Export</h5>
                    <p>Export grids and markers</p>
                    <a href="/admin/export" class="waves-effect waves-light blue btn">Download export</a>
                </div>
            </div>
            <div class="card">
                <div class="card-content">
                    <h5>Merge</h5>
                    <p>Note, merge is experimental at this time, use at your own risk!</p>
                    <form action="/admin/merge" method="post" enctype="multipart/form-data">
                        <div class="file-field input-field">
                        <div class="btn">
                            <span>File</span>
                            <input type="file" name="merge">
                        </div>
                        <div class="file-path-wrapper">
                            <input class="file-path validate" type="text">
                        </div>
                        </div>
                        <button class="btn waves-effect waves-light" type="submit" name="action">Merge</button>
                    </form>
                </div>
            </div>
		</div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
        <script>M.AutoInit();</script>
	</body>
</html>