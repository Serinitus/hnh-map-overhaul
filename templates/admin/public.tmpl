<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<link rel="stylesheet" href="/js/dark.css">
		<style>
		</style>
        <title>{{.Page.Title}} - Admin</title>
	</head>
	<body>
		{{template "navbar.tmpl" .}}
		<div class="container">
            <form method="POST">
                <div class="col s12">
                    <ul class="collection with-header">
                        <li class="collection-header">
                            <h6>Public Access</h6>
                            <p>When enabled, anyone with no logged-in account gets this set
                                of permissions -- the home page becomes the map instead of
                                the login screen, and the account menu shows "Login" instead
                                of a username. Leave disabled to keep this instance
                                login-only, regardless of what's checked below.</p>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="enabled" value="true"{{if .Config.Enabled}} checked="checked"{{end}}/>
                                <span>Enable Public Access</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="col s12">
                    <ul class="collection with-header">
                        <li class="collection-header">
                            <h6>Public upload token</h6>
                            <p>Optional. Advertised on the public Tokens page for anonymous
                                visitors to copy into a client tool -- shared infrastructure,
                                not a personal credential. Leave blank to show no token there.
                                Click "Generate Public Token" below for a fresh one that isn't
                                tied to any account, or paste in a real token from some
                                account's own Tokens page instead if you'd rather reuse one.</p>
                        </li>
                        <li class="collection-item">
                            <div class="input-field">
                                <input id="token" type="text" name="token" value="{{.Config.Token}}">
                                <label for="token" class="active">Token</label>
                            </div>
                            <a href="/admin/generatePublicToken" class="waves-effect waves-light btn">Generate Public Token</a>
                        </li>
                    </ul>
                </div>
                <div class="col s12">
                    <ul class="collection with-header">
                        <li class="collection-header">
                            <h6>Roles</h6>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="map"{{if .Config.Auths.Has "map"}} checked="checked"{{end}}/>
                                <span>Map</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="markers"{{if .Config.Auths.Has "markers"}} checked="checked"{{end}}/>
                                <span>Markers</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="point"{{if .Config.Auths.Has "point"}} checked="checked"{{end}}/>
                                <span>Characters</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="g1"{{if .Config.Auths.Has "g1"}} checked="checked"{{end}}/>
                                <span>Group 1</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="g2"{{if .Config.Auths.Has "g2"}} checked="checked"{{end}}/>
                                <span>Group 2</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="g3"{{if .Config.Auths.Has "g3"}} checked="checked"{{end}}/>
                                <span>Group 3</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="g4"{{if .Config.Auths.Has "g4"}} checked="checked"{{end}}/>
                                <span>Group 4</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="g5"{{if .Config.Auths.Has "g5"}} checked="checked"{{end}}/>
                                <span>Group 5</span>
                            </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="upload"{{if .Config.Auths.Has "upload"}} checked="checked"{{end}}/>
                                <span>Upload</span>
                            </label>
                        </li>
                        <li class="collection-item">
                           <label>
                               <input type="checkbox" name="auths" value="writer"{{if .Config.Auths.Has "writer"}} checked="checked"{{end}}/>
                               <span>Redactor</span>
                           </label>
                        </li>
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="admin"{{if .Config.Auths.Has "admin"}} checked="checked"{{end}}/>
                                <span>Admin</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="col s12">
                    <ul class="collection with-header">
                        <li class="collection-header">
                            <h6>Markers</h6>
                            <p>Which settings-drawer sections public visitors can see on the map.</p>
                        </li>
                        {{range .SectionOptions}}
                        <li class="collection-item">
                            <label>
                                <input type="checkbox" name="auths" value="sec_{{.Key}}"{{if $.Config.Auths.Has (print "sec_" .Key)}} checked="checked"{{end}}/>
                                <span>{{.Label}}</span>
                            </label>
                        </li>
                        {{end}}
                    </ul>
                </div>
                <button class="btn waves-effect waves-light" type="submit" name="action">Save</button>
            </form>
		</div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
        <script>M.AutoInit();</script>
	</body>
</html>
