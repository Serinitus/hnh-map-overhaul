<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<link rel="stylesheet" href="/js/dark.css">
		<style>
		</style>
		<title>{{.Page.Title}}</title>
	</head>
	<body>
		{{template "navbar.tmpl" .}}
		<div class="container">
			<div class="row">
			{{if not .Locked}}
			<div class="col s3">
			<a class="waves-effect waves-light btn" href="/password">Change Password</a><br>
			</div>
			{{end}}
			<div class="col s9">
			{{if .Session.Auths.Has "upload" }}
				<ul class="collection with-header">
				<li class="collection-header">{{if .Locked}}Shared public upload token.{{else}}Here are your existing upload tokens.{{end}}</li>
				{{range .UploadTokens}}
					<li class="collection-item token-line" data-token="{{.}}">{{$.Prefix}}/client/{{.}}</li>
				{{else}}
					<li class="collection-item">{{if .Locked}}No shared token has been set up yet.{{else}}You have no tokens, generate one now!{{end}}</li>
				{{end}}
				</ul>
				{{if not .Locked}}
				<a class="waves-effect waves-light btn" href="/generateToken">Generate Token</a>
				{{end}}
				{{if .UploadTokens}}
				<p style="margin-bottom:0;color:#9e9e9e;font-size:0.85rem;">Not reachable from your client? Edit the address below -- just for you, nothing is saved.</p>
				<div class="input-field" style="max-width:500px;">
					<input id="prefixOverride" type="text" value="{{.Prefix}}">
					<label for="prefixOverride" class="active">Address override</label>
				</div>
				<script>
					document.getElementById('prefixOverride').addEventListener('input', function (e) {
						var value = e.target.value.replace(/\/+$/, '');
						document.querySelectorAll('.token-line').forEach(function (el) {
							el.textContent = value + '/client/' + el.dataset.token;
						});
					});
				</script>
				{{end}}
			{{end}}
			</div>
			</div>
		</div>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
	</body>
</html>